import os

projectName = 'botcontrol'

# smsdk_ext.cpp will be automatically added later
sourceFiles = [
  'extension.cpp',
  'detours.cpp',
  'listeners.cpp'
]

###############
# Make sure to edit PackageScript, which copies your files to their appropriate locations
# Simple extensions do not need to modify past this point.

project = Extension.HL2Project(builder, projectName + '.ext')

if os.path.isfile(os.path.join(builder.currentSourcePath, 'sdk', 'smsdk_ext.cpp')):
  # Use the copy included in the project
  project.sources += [os.path.join('sdk', 'smsdk_ext.cpp')]
else:
  # Use the copy included with SM 1.6 and newer
  project.sources += [os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp')]

project.sources += [
  os.path.join(Extension.sm_root, 'public', 'CDetour', 'detours.cpp'),
  os.path.join(Extension.sm_root, 'public', 'safetyhook', 'src', 'allocator.cpp'),
  os.path.join(Extension.sm_root, 'public', 'safetyhook', 'src', 'easy.cpp'),
  os.path.join(Extension.sm_root, 'public', 'safetyhook', 'src', 'inline_hook.cpp'),
  os.path.join(Extension.sm_root, 'public', 'safetyhook', 'src', 'mid_hook.cpp'),
  os.path.join(Extension.sm_root, 'public', 'safetyhook', 'src', 'utility.cpp'),
  os.path.join(Extension.sm_root, 'public', 'safetyhook', 'src', 'vmt_hook.cpp'),
  os.path.join(Extension.sm_root, 'public', 'safetyhook', 'zydis', 'Zydis.c'),
]

if builder.target_platform == 'windows':
  project.sources += [os.path.join(Extension.sm_root, 'public', 'safetyhook', 'src', 'os.windows.cpp')]
elif builder.target_platform == 'linux':
  project.sources += [os.path.join(Extension.sm_root, 'public', 'safetyhook', 'src', 'os.linux.cpp')]

project.sources += sourceFiles

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]

  binary = Extension.HL2Config(project, projectName + '.ext.' + sdk.ext, sdk)

Extension.extensions = builder.Add(project)
